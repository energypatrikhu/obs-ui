{
  "name": "@obs-ui/extension",
  "description": "Energy's OBS Now Playing Extension",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build && bun ./move.ts",
    "build:firefox": "wxt build -b firefox && bun ./move.ts",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "prepare": "wxt prepare"
  },
  "devDependencies": {
    "@tsconfig/svelte": "^5.0.8",
    "@types/lodash": "4.17.25",
    "@wxt-dev/module-svelte": "2.0.5",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tslib": "2.8.1",
    "typescript": "7.0.2",
    "wxt": "^0.21.4"
  },
  "dependencies": {
    "@energypatrikhu/node-utils": "0.2.3",
    "lodash": "4.18.1"
  }
}
